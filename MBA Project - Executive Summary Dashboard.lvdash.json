{
  "datasets": [
    {
      "name": "abc_summary",
      "displayName": "ABC Summary",
      "queryLines": [
        "SELECT\n",
        "  abc_category,\n",
        "  COUNT(*) as product_count,\n",
        "  ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) as product_percentage,\n",
        "  ROUND(SUM(total_revenue), 2) as total_revenue,\n",
        "  ROUND(SUM(total_revenue) * 100.0 / SUM(SUM(total_revenue)) OVER (), 2) as revenue_percentage\n",
        "FROM\n",
        "  abc_analysis\n",
        "GROUP BY\n",
        "  abc_category\n",
        "ORDER BY\n",
        "  abc_category"
      ]
    },
    {
      "name": "hml_analysis",
      "displayName": "HML Analysis",
      "queryLines": [
        "SELECT\n",
        "  hml_category,\n",
        "  COUNT(*) as product_count,\n",
        "  ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) as product_percentage,\n",
        "  ROUND(MIN(Price), 2) as min_price,\n",
        "  ROUND(MAX(Price), 2) as max_price,\n",
        "  ROUND(AVG(Price), 2) as avg_price\n",
        "FROM\n",
        "  hml_analysis\n",
        "GROUP BY\n",
        "  hml_category\n",
        "ORDER BY\n",
        "  CASE hml_category\n",
        "    WHEN 'High' THEN 1\n",
        "    WHEN 'Medium' THEN 2\n",
        "    ELSE 3\n",
        "  END"
      ]
    },
    {
      "name": "executive_summary",
      "displayName": "Executive Metrics",
      "config": {
        "source": "commercial.base.sales",
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(source.TotalPrice)",
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_quantity",
            "expr": "SUM(source.Quantity)",
            "displayName": "Total Quantity"
          },
          {
            "name": "total_transactions",
            "expr": "COUNT(DISTINCT source.SalesID)",
            "displayName": "Total Transactions"
          },
          {
            "name": "active_customers",
            "expr": "COUNT(DISTINCT source.CustomerID)",
            "displayName": "Active Customers"
          },
          {
            "name": "total_products_sold",
            "expr": "COUNT(DISTINCT source.ProductID)",
            "displayName": "Total Products Sold"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(source.TotalPrice) / COUNT(DISTINCT source.SalesID)",
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_discount",
            "expr": "AVG(source.Discount)",
            "displayName": "Avg Discount",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "sales_date",
            "expr": "source.SalesDate",
            "displayName": "Sales Date"
          },
          {
            "name": "sales_month",
            "expr": "DATE_TRUNC('month', source.SalesDate)",
            "displayName": "Sales Month"
          },
          {
            "name": "sales_day",
            "expr": "DATE_TRUNC('day', source.SalesDate)",
            "displayName": "Sales Day"
          },
          {
            "name": "product_name",
            "expr": "products.ProductName",
            "displayName": "Product Name"
          },
          {
            "name": "product_class",
            "expr": "products.Class",
            "displayName": "Product Class"
          },
          {
            "name": "customer_name",
            "expr": "CONCAT(customers.FirstName, ' ', customers.LastName)",
            "displayName": "Customer Name"
          },
          {
            "name": "transaction_number",
            "expr": "source.TransactionNumber",
            "displayName": "Transaction Number"
          }
        ],
        "joins": [
          {
            "name": "products",
            "source": "commercial.base.products",
            "on": "source.ProductID = products.ProductID"
          },
          {
            "name": "customers",
            "source": "commercial.base.customers",
            "on": "source.CustomerID = customers.CustomerID"
          }
        ]
      }
    }
  ],
